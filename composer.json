{
    "name": "local/payxy-playground",
    "description": "Local app that consumes payxy/payxy-php-sdk from Packagist (backend and frontend flows).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.9",
        "payxy/payxy-php-sdk": "^1.0.3"
    },
    "autoload": {
        "psr-4": { "Playground\\": "src/" }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "php-http/discovery": false }
    }
}
